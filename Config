local function isNPC(hum)
    local model = hum.Parent
    if not model or not model:IsA("Model") then return false end
    if Players:GetPlayerFromCharacter(model) then return false end
    return true
end

local function isDead(hum)
    if hum.Health <= 0 then return true end
    if not hum:IsDescendantOf(workspace) then return true end
    local ok, st = pcall(function() return hum:GetState() end)
    if ok and st == Enum.HumanoidStateType.Dead then return true end
    return false
end

local function applySide(holder)
    if espSide == "Direita" then
        holder.AnchorPoint = Vector2.new(0, 0.5)
        holder.Position = UDim2.new(0.5, ESP_OFFSET, 0.5, 0)
    elseif espSide == "Esquerda" then
        holder.AnchorPoint = Vector2.new(1, 0.5)
        holder.Position = UDim2.new(0.5, -ESP_OFFSET, 0.5, 0)
    else
        -- em cima da cabeça (parte de baixo do conjunto fica logo acima da cabeça)
        holder.AnchorPoint = Vector2.new(0.5, 1)
        holder.Position = UDim2.new(0.5, 0, 0.5, 0)
    end
end

local function removeEsp(hum)
    local d = espData[hum]
    if not d then return end
    espData[hum] = nil
    for _, c in ipairs(d.conns) do c:Disconnect() end
    if d.gui then d.gui:Destroy() end
end

local function addEsp(hum)
    if not espEnabled or espData[hum] then return end
    if not hum.Parent or not isNPC(hum) or isDead(hum) then return end

    local model = hum.Parent
    -- HumanoidRootPart não balança com a animação (a cabeça balança)
    local adornee = model:FindFirstChild("HumanoidRootPart")
        or model.PrimaryPart
        or model:FindFirstChild("Head")
        or model:FindFirstChildWhichIsA("BasePart")
    if not adornee then return end

    local col = getEspColor(model)
    local height = math.clamp(model:GetExtentsSize().Y / 2 + 0.5, 2.5, 15)

    local bb = new("BillboardGui", {
        Name = "NPCESP",
        Adornee = adornee,
        AlwaysOnTop = true,
        Size = UDim2.fromOffset(600, 80),
        -- offset no mundo (fixo): não muda de direção quando a câmera inclina
        StudsOffsetWorldSpace = Vector3.new(0, height, 0),
        MaxDistance = 2000,
    }, espFolder)

    -- Container transparente (sem frame de fundo)
    local holder = new("Frame", {
        Size = UDim2.fromOffset(140, 52),
        BackgroundTransparency = 1,
    }, bb)

    -- Nome
    new("TextLabel", {
        Size = UDim2.new(1, 0, 0, 12), Position = UDim2.new(0, 0, 0, 0),
        BackgroundTransparency = 1, Text = model.Name, TextColor3 = col,
        Font = Enum.Font.GothamBold, TextSize = 11,
        TextStrokeTransparency = 0.4, TextStrokeColor3 = Color3.new(0, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Center,
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, holder)

    -- Barra de VIDA (verde, primeira)
    local hpBg = new("Frame", {
        Size = UDim2.new(1, 0, 0, 11), Position = UDim2.new(0, 0, 0, 14),
        BackgroundColor3 = C.off, BorderSizePixel = 0,
    }, holder)
    corner(hpBg, 4); stroke(hpBg, Color3.new(0, 0, 0), 1)
    local hpFill = new("Frame", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = C.hp, BorderSizePixel = 0,
    }, hpBg)
    corner(hpFill, 4)
    local hpLbl = new("TextLabel", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "",
        TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.GothamBold, TextSize = 9,
        TextStrokeTransparency = 0.4, TextStrokeColor3 = Color3.new(0, 0, 0), ZIndex = 2,
    }, hpBg)

    -- Barra de ENERGIA (azul, embaixo da vida)
    local enBg = new("Frame", {
        Size = UDim2.new(1, 0, 0, 11), Position = UDim2.new(0, 0, 0, 27),
        BackgroundColor3 = C.off, BorderSizePixel = 0,
    }, holder)
    corner(enBg, 4); stroke(enBg, Color3.new(0, 0, 0), 1)
    local enFill = new("Frame", {
        Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = C.mana, BorderSizePixel = 0,
    }, enBg)
    corner(enFill, 4)
    local enLbl = new("TextLabel", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "",
        TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.GothamBold, TextSize = 9,
        TextStrokeTransparency = 0.4, TextStrokeColor3 = Color3.new(0, 0, 0), ZIndex = 2,
    }, enBg)

    -- GRAU (pequeno, embaixo, sem frame)
    local grLbl = new("TextLabel", {
        Size = UDim2.new(1, 0, 0, 10), Position = UDim2.new(0, 0, 0, 40),
        BackgroundTransparency = 1, Text = "", TextColor3 = Color3.fromRGB(215, 200, 200),
        Font = Enum.Font.GothamMedium, TextSize = 9,
        TextStrokeTransparency = 0.5, TextStrokeColor3 = Color3.new(0, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Center,
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, holder)

    local d = {gui = bb, holder = holder, conns = {}, peak = 0}

    local function update()
        if isDead(hum) then removeEsp(hum) return end
        local mx = math.max(hum.MaxHealth, 1)
        local h = math.clamp(hum.Health, 0, mx)
        local pct = h / mx
        hpFill.Size = UDim2.new(pct, 0, 1, 0)
        hpLbl.Text = string.format("%d/%d  •  %d%%", math.floor(h + 0.5), math.floor(mx + 0.5), math.floor(pct * 100 + 0.5))
    end

    local function refreshStats()
        -- Energia
        local raw = readRaw(model, "energia")
        if raw == nil then
            enFill.Size = UDim2.new(0, 0, 1, 0)
            enLbl.Text = "Energia: Fraca"
        else
            local cur = tonumber(raw)
            if cur then
                local mxRaw = tonumber(readRaw(model, "energiamax"))
                d.peak = math.max(d.peak, cur)
                local m = (mxRaw and mxRaw > 0) and mxRaw or d.peak
                local pct = (m > 0) and math.clamp(cur / m, 0, 1) or 0
                enFill.Size = UDim2.new(pct, 0, 1, 0)
                if mxRaw and mxRaw > 0 then
                    enLbl.Text = fmtVal(cur) .. "/" .. fmtVal(mxRaw)
                else
                    enLbl.Text = fmtVal(cur)
                end
            else
                enFill.Size = UDim2.new(1, 0, 1, 0)
                enLbl.Text = tostring(raw)
            end
        end
        -- Grau
        local g = readRaw(model, "grau")
        grLbl.Text = "Grau: " .. (g ~= nil and fmtVal(g) or "Fraca")
    end

    espData[hum] = d
    applySide(holder)
    update()
    if not espData[hum] then return end
    refreshStats()

    -- Remoção quando morrer (várias garantias)
    table.insert(d.conns, hum.HealthChanged:Connect(update))
    table.insert(d.conns, hum:GetPropertyChangedSignal("MaxHealth"):Connect(update))
    table.insert(d.conns, hum.Died:Connect(function() removeEsp(hum) end))
    table.insert(d.conns, hum.StateChanged:Connect(function(_, new)
        if new == Enum.HumanoidStateType.Dead then removeEsp(hum) end
    end))
    table.insert(d.conns, hum.AncestryChanged:Connect(function()
        if not hum:IsDescendantOf(workspace) then removeEsp(hum) end
    end))
    table.insert(d.conns, adornee.AncestryChanged:Connect(function()
        if not adornee:IsDescendantOf(workspace) then removeEsp(hum) end
    end))

    -- Loop de atualização + checagem de morte
    task.spawn(function()
        while true do
            task.wait(0.4)
            if espData[hum] ~= d then break end
            if isDead(hum) or not adornee:IsDescendantOf(workspace) then
                removeEsp(hum)
                break
            end
            refreshStats()
        end
    end)
end

local function setEsp(on)
    espEnabled = on
    for hum in pairs(espData) do removeEsp(hum) end
    for _, c in ipairs(espConns) do c:Disconnect() end
    espConns = {}
    if on then
        for _, d in ipairs(workspace:GetDescendants()) do
            if d:IsA("Humanoid") then addEsp(d) end
        end
        table.insert(espConns, workspace.DescendantAdded:Connect(function(d)
            if d:IsA("Humanoid") then task.delay(0.3, addEsp, d) end
        end))
    end
end

