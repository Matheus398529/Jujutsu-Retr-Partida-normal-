local function new(class, props, par)
    local o = Instance.new(class)
    for k, v in pairs(props) do o[k] = v end
    o.Parent = par
    return o
end
local function corner(o, r) return new("UICorner", {CornerRadius = UDim.new(0, r or 6)}, o) end
local function stroke(o, col, t) return new("UIStroke", {Color = col or C.red, Thickness = t or 1}, o) end

