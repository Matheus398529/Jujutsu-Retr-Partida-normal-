local function makePool(ids, copies)
    local pool = {}
    for _, id in ipairs(ids) do
        for _ = 1, copies do
            local s = Instance.new("Sound")
            s.SoundId = "rbxassetid://" .. id
            s.Volume = soundVolume
            s.Parent = gui
            table.insert(pool, s)
        end
    end
    return pool
end

