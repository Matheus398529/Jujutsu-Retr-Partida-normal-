    pcall(function()
        ContentProvider:PreloadAsync(funcPool)
        ContentProvider:PreloadAsync(tabPool)
    end)
end)

local function playFromPool(pool)
    if not soundEnabled then return end
    local total = #pool
    local start = math.random(1, total)
    for i = 0, total - 1 do
        local s = pool[(start + i - 1) % total + 1]
        if not s.IsPlaying then
            s.Volume = soundVolume
            s.TimePosition = 0
            s:Play()
            return
        end
    end
    local s = pool[start]
    s.Volume = soundVolume
    s.TimePosition = 0
    s:Play()
end

local function playClick() playFromPool(funcPool) end -- funções
local function playTab() playFromPool(tabPool) end     -- troca de aba

