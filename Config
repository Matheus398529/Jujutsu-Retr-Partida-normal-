--// Sistema de abas
local pages, tabBtns = {}, {}
local function selectTab(name)
    for n, p in pairs(pages) do p.Visible = (n == name) end
    for n, b in pairs(tabBtns) do
        TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = (n == name) and C.red or C.panel}):Play()
    end
end

local function NewTab(name)
    local b = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = C.panel, Text = name,
        TextColor3 = C.text, Font = Enum.Font.GothamMedium, TextSize = 13, AutoButtonColor = false,
    }, sidebar)
    corner(b, 6)
    local p = new("Frame", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Visible = false}, content)
    pages[name], tabBtns[name] = p, b
    b.MouseButton1Click:Connect(function()
        playTab() -- som exclusivo de troca de aba
        selectTab(name)
    end)
    return p
end

