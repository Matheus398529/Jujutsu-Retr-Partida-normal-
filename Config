local COPIES = 3
local soundEnabled = true
local soundVolume = 0.6

local function makePool(ids, copies)
    local pool = {}
    for _, id in ipairs(ids) do
        for _ = 1, copies do
            local s = Instance.new("Sound")
            s.SoundId = "rbxassetid://" .. id
            s.Volume = soundVolume
            s.Parent = gui
            table.insert(pool, s)
        end
    end
    return pool
end

local funcPool = makePool(FUNC_SOUND_IDS, COPIES)
local tabPool = makePool({TAB_SOUND_ID}, COPIES)

