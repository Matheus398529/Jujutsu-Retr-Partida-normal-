-- Busca de Energia Amaldiçoada / Energia máxima / Grau
local function norm(s) return (tostring(s):lower():gsub("[%s_%-]", "")) end
local function isEnergiaBase(n)
    n = norm(n)
    return (n:find("energ", 1, true) and n:find("amaldi", 1, true)) ~= nil
        or n:find("cursedenergy", 1, true) ~= nil
end
local function hasMax(n)
    return norm(n):find("max", 1, true) ~= nil
end
local function isEnergia(n) return isEnergiaBase(n) and not hasMax(n) end
local function isEnergiaMax(n) return isEnergiaBase(n) and hasMax(n) end
local function isGrau(n)
    n = norm(n)
    return n:find("grau", 1, true) ~= nil or n:find("grade", 1, true) ~= nil
end
local KINDS = {"energia", "energiamax", "grau"}
local matchers = {energia = isEnergia, energiamax = isEnergiaMax, grau = isGrau}

local function fromInst(inst, m)
    if inst:IsA("ValueBase") and m(inst.Name) then
        return function() return inst.Value end
    end
    for k in pairs(inst:GetAttributes()) do
        if m(k) then return function() return inst:GetAttribute(k) end end
    end
    return nil
end

local function findInModel(model, kind)
    local m = matchers[kind]
    local g = fromInst(model, m)
    if g then return g end
    for _, d in ipairs(model:GetDescendants()) do
        g = fromInst(d, m)
        if g then return g end
    end
    return nil
end

-- Índice global (jogo inteiro), compartilhado entre os NPCs
local gIndex = {energia = {}, energiamax = {}, grau = {}, t = 0, busy = false}

local function indexInst(inst, out)
    if inst:IsA("ValueBase") then
        local n = inst.Name
        for _, kind in ipairs(KINDS) do
            if matchers[kind](n) then table.insert(out[kind], inst) end
        end
    end
    local attrs = inst:GetAttributes()
    if next(attrs) then
        for k in pairs(attrs) do
            for _, kind in ipairs(KINDS) do
                if matchers[kind](k) then table.insert(out[kind], inst) end
            end
        end
    end
end

local function refreshIndex()
    if gIndex.busy or tick() - gIndex.t < 8 then return end
    gIndex.busy = true
    task.spawn(function()
        local out = {energia = {}, energiamax = {}, grau = {}}
        local ok = pcall(function()
            local n = 0
            for _, d in ipairs(game:GetDescendants()) do
                indexInst(d, out)
                n = n + 1
                if n % 3000 == 0 then task.wait() end
            end
        end)
        if ok then
            gIndex.energia, gIndex.energiamax, gIndex.grau = out.energia, out.energiamax, out.grau
        end
        gIndex.t = tick()
        gIndex.busy = false
    end)
end

local function findGlobal(model, kind)
    refreshIndex()
    local m = matchers[kind]
    for _, inst in ipairs(gIndex[kind]) do
        local anc = inst.Parent
        while anc and anc ~= game do
            if anc == model or anc.Name == model.Name then
                return fromInst(inst, m)
            end
            anc = anc.Parent
        end
    end
    return nil
end

local statCache = setmetatable({}, {__mode = "k"})
local function fmtVal(v)
    if typeof(v) == "number" then
        return tostring(math.floor(v * 100 + 0.5) / 100)
    end
    return tostring(v)
end

-- Retorna o valor cru (ou nil se não achou)
local function readRaw(model, kind)
    local c = statCache[model]
    if not c then c = {}; statCache[model] = c end
    local ent = c[kind]
    if ent and ent.get then
        local ok, v = pcall(ent.get)
        if ok and v ~= nil then return v end
        ent.get = nil
    end
    if not ent or tick() - ent.t > 3 then
        ent = {t = tick()}
        c[kind] = ent
        ent.get = findInModel(model, kind) or findGlobal(model, kind)
        if ent.get then
            local ok, v = pcall(ent.get)
            if ok and v ~= nil then return v end
        end
    end
    return nil
end

